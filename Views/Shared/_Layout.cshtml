<!DOCTYPE html>
<html lang="ru" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] — Портфолио GameDev</title>

    @if (ViewData["Description"] is string desc) {
        <meta name="description" content="@desc" />
    }

    @* ─── Tailwind CSS (CDN) ───────────────────────────────────── *@
    <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
    <script>
        // Кастомная тема Tailwind — цвета бренда, шрифты и т.п.
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50:  '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        },
                    },
                },
            },
        };
    </script>

    @* ─── Шрифт Inter ──────────────────────────────────────────── *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    @* ─── AOS (анимации при скролле) ───────────────────────────── *@
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />

    @* ─── Свои стили ───────────────────────────────────────────── *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 font-sans antialiased">

    @* ═══ HEADER ═════════════════════════════════════════════════ *@
    <header class="sticky top-0 z-40 backdrop-blur bg-white/80 border-b border-slate-200">
        <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">

            @* Лого *@
            <a asp-controller="Home" asp-action="Index"
               class="flex items-center gap-2 font-bold text-lg text-slate-900 hover:text-brand-600 transition">
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-brand-600 text-white text-sm">
                    GD
                </span>
                <span class="hidden sm:inline">GameDev Portfolio</span>
            </a>

            @* Основная навигация (desktop) *@
            <ul class="hidden md:flex items-center gap-1 text-sm font-medium text-slate-600">
                <li><a asp-controller="Home" asp-action="Index" class="px-3 py-2 rounded-md hover:text-brand-600 hover:bg-brand-50 transition">Главная</a></li>
                <li><a asp-controller="Projects" asp-action="Index" class="px-3 py-2 rounded-md hover:text-brand-600 hover:bg-brand-50 transition">Проекты</a></li>
                <li><a asp-controller="Skills" asp-action="Index" class="px-3 py-2 rounded-md hover:text-brand-600 hover:bg-brand-50 transition">Навыки</a></li>
                <li><a asp-controller="Experience" asp-action="Index" class="px-3 py-2 rounded-md hover:text-brand-600 hover:bg-brand-50 transition">Опыт</a></li>
                <li><a asp-controller="Blog" asp-action="Index" class="px-3 py-2 rounded-md hover:text-brand-600 hover:bg-brand-50 transition">Блог</a></li>
                <li><a asp-controller="Resume" asp-action="Index" class="px-3 py-2 rounded-md hover:text-brand-600 hover:bg-brand-50 transition">Резюме</a></li>
                <li><a asp-controller="Home" asp-action="Contact" class="ml-2 px-4 py-2 rounded-md bg-brand-600 text-white hover:bg-brand-700 transition">Связаться</a></li>
            </ul>

            @* Кнопка burger для мобилки *@
            <button type="button" id="navToggle"
                    class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-md hover:bg-slate-100"
                    aria-label="Открыть меню">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        </nav>

        @* Мобильное меню (скрыто по умолчанию) *@
        <ul id="navMenu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 py-3 space-y-1 text-sm font-medium text-slate-700">
            <li><a asp-controller="Home" asp-action="Index" class="block px-3 py-2 rounded-md hover:bg-slate-100">Главная</a></li>
            <li><a asp-controller="Projects" asp-action="Index" class="block px-3 py-2 rounded-md hover:bg-slate-100">Проекты</a></li>
            <li><a asp-controller="Skills" asp-action="Index" class="block px-3 py-2 rounded-md hover:bg-slate-100">Навыки</a></li>
            <li><a asp-controller="Experience" asp-action="Index" class="block px-3 py-2 rounded-md hover:bg-slate-100">Опыт</a></li>
            <li><a asp-controller="Blog" asp-action="Index" class="block px-3 py-2 rounded-md hover:bg-slate-100">Блог</a></li>
            <li><a asp-controller="Resume" asp-action="Index" class="block px-3 py-2 rounded-md hover:bg-slate-100">Резюме</a></li>
            <li><a asp-controller="Home" asp-action="Contact" class="block px-3 py-2 rounded-md bg-brand-600 text-white">Связаться</a></li>
        </ul>
    </header>

    @* ═══ MAIN ═══════════════════════════════════════════════════ *@
    <main class="flex-1">
        @RenderBody()
    </main>

    @* ═══ FOOTER ═════════════════════════════════════════════════ *@
    <footer class="mt-16 border-t border-slate-200 bg-white">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500">
            <p>© @DateTime.UtcNow.Year GameDev Portfolio. Все права защищены.</p>
            <ul class="flex items-center gap-4">
                <li><a asp-controller="Home" asp-action="About" class="hover:text-brand-600 transition">О себе</a></li>
                <li><a asp-controller="Home" asp-action="Contact" class="hover:text-brand-600 transition">Контакты</a></li>
                <li>
                    <a asp-controller="Sitemap" asp-action="Index" class="hover:text-brand-600 transition" title="Карта сайта">Sitemap</a>
                </li>
            </ul>
        </div>
    </footer>

    @* ═══ SCRIPTS ════════════════════════════════════════════════ *@
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        // Инициализация AOS (анимации появления при скролле).
        // Отключаем на мобильных, чтобы не мешало — можно убрать условие, если нужно.
        AOS.init({
            duration: 600,
            easing: 'ease-out-cubic',
            once: true,
            offset: 60,
            disable: 'phone',
        });
    </script>

    @* Минимальный JS для burger-меню *@
    <script>
        document.getElementById('navToggle')?.addEventListener('click', () => {
            document.getElementById('navMenu')?.classList.toggle('hidden');
        });
    </script>

    @* Свой скрипт сайта (пока пустой) *@
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>