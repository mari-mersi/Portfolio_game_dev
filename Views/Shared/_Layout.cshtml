@inject IWebHostEnvironment Env
@{
    // ── Значения по умолчанию ────────────────────────────────────
    var pageTitle = ViewData["Title"] as string ?? "Портфолио GameDev";
    var pageDescription = ViewData["Description"] as string
        ?? "Портфолио геймдизайнера: проекты, навыки, статьи о разработке игр.";

    // OG-картинка: из ViewData или дефолтная
    var ogImageRaw = ViewData["OgImage"] as string ?? "/images/og-default.png";

    // Абсолютный URL (OG требует именно абсолютный)
    var scheme = Context.Request.Scheme;
    var host = Context.Request.Host;
    var absoluteOgImage = ogImageRaw.StartsWith("http")
        ? ogImageRaw
        : $"{scheme}://{host}{ogImageRaw}";

    var absoluteUrl = $"{scheme}://{host}{Context.Request.Path}{Context.Request.QueryString}";

    // Для отладки: в dev — не кэшируем CSS (asp-append-version сам разберётся)
    var isDev = Env.IsDevelopment();
}
<!DOCTYPE html>
<html lang="ru" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#4f46e5" />

    <title>@pageTitle — GameDev Portfolio</title>
    <meta name="description" content="@pageDescription" />

    @* ─── Open Graph ────────────────────────────────────────────── *@
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GameDev Portfolio" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@absoluteUrl" />
    <meta property="og:image" content="@absoluteOgImage" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ru_RU" />

    @* ─── Twitter Cards ─────────────────────────────────────────── *@
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:image" content="@absoluteOgImage" />

    @* ─── Canonical (защита от дублей) ──────────────────────────── *@
    <link rel="canonical" href="@absoluteUrl" />

    @* ─── Preconnect (быстрее грузим внешние ресурсы) ──────────── *@
    <link rel="preconnect" href="https://unpkg.com" />

    @* ─── AOS (анимации при скролле) ────────────────────────────── *@
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />

    @* ─── Tailwind CSS (собран через PostCSS) ───────────────────── *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* ─── Favicon + manifest ────────────────────────────────────── *@
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="manifest" href="~/manifest.json" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 font-sans antialiased">

    @* ─── Skip-link (a11y) ──────────────────────────────────────── *@
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-brand-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-md focus:shadow-lg">
        Перейти к содержимому
    </a>

    @* ═══ HEADER ═════════════════════════════════════════════════ *@
    <header class="sticky top-0 z-40 backdrop-blur bg-white/80 border-b border-slate-200">
        <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between"
             aria-label="Основная навигация">

            @* Лого *@
            <a asp-controller="Home" asp-action="Index"
               class="flex items-center gap-2 font-bold text-lg text-slate-900 hover:text-brand-600 transition focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 rounded-md">
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-brand-600 text-white text-sm"
                      aria-hidden="true">
                    GD
                </span>
                <span class="hidden sm:inline">GameDev Portfolio</span>
            </a>

            @* Основная навигация (desktop) *@
            <ul class="hidden md:flex items-center gap-1 text-sm font-medium text-slate-600">
                <li><a asp-controller="Home" asp-action="Index" class="px-3 py-2 rounded-md hover:text-brand-600 hover:bg-brand-50 transition focus:outline-none focus:ring-2 focus:ring-brand-500">Главная</a></li>
                <li><a asp-controller="Projects" asp-action="Index" class="px-3 py-2 rounded-md hover:text-brand-600 hover:bg-brand-50 transition focus:outline-none focus:ring-2 focus:ring-brand-500">Проекты</a></li>
                <li><a asp-controller="Skills" asp-action="Index" class="px-3 py-2 rounded-md hover:text-brand-600 hover:bg-brand-50 transition focus:outline-none focus:ring-2 focus:ring-brand-500">Навыки</a></li>
                <li><a asp-controller="Experience" asp-action="Index" class="px-3 py-2 rounded-md hover:text-brand-600 hover:bg-brand-50 transition focus:outline-none focus:ring-2 focus:ring-brand-500">Опыт</a></li>
                <li><a asp-controller="Blog" asp-action="Index" class="px-3 py-2 rounded-md hover:text-brand-600 hover:bg-brand-50 transition focus:outline-none focus:ring-2 focus:ring-brand-500">Блог</a></li>
                <li><a asp-controller="Resume" asp-action="Index" class="px-3 py-2 rounded-md hover:text-brand-600 hover:bg-brand-50 transition focus:outline-none focus:ring-2 focus:ring-brand-500">Резюме</a></li>
                <li><a asp-controller="Home" asp-action="Contact" class="ml-2 px-4 py-2 rounded-md bg-brand-600 text-white hover:bg-brand-700 transition focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2">Связаться</a></li>
            </ul>

            @* Кнопка burger для мобилки *@
            <button type="button" id="navToggle"
                    class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-md hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500"
                    aria-label="Открыть меню"
                    aria-expanded="false"
                    aria-controls="navMenu">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        </nav>

        @* Мобильное меню (скрыто по умолчанию) *@
        <ul id="navMenu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 py-3 space-y-1 text-sm font-medium text-slate-700">
            <li><a asp-controller="Home" asp-action="Index" class="block px-3 py-2 rounded-md hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500">Главная</a></li>
            <li><a asp-controller="Projects" asp-action="Index" class="block px-3 py-2 rounded-md hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500">Проекты</a></li>
            <li><a asp-controller="Skills" asp-action="Index" class="block px-3 py-2 rounded-md hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500">Навыки</a></li>
            <li><a asp-controller="Experience" asp-action="Index" class="block px-3 py-2 rounded-md hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500">Опыт</a></li>
            <li><a asp-controller="Blog" asp-action="Index" class="block px-3 py-2 rounded-md hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500">Блог</a></li>
            <li><a asp-controller="Resume" asp-action="Index" class="block px-3 py-2 rounded-md hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500">Резюме</a></li>
            <li><a asp-controller="Home" asp-action="Contact" class="block px-3 py-2 rounded-md bg-brand-600 text-white focus:outline-none focus:ring-2 focus:ring-brand-500">Связаться</a></li>
        </ul>
    </header>

    @* ═══ MAIN ═══════════════════════════════════════════════════ *@
    <main id="main-content" class="flex-1">
        @RenderBody()
    </main>

    @* ═══ FOOTER ═════════════════════════════════════════════════ *@
    <footer class="mt-16 border-t border-slate-200 bg-white">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500">
            <p>© @DateTime.UtcNow.Year GameDev Portfolio. Все права защищены.</p>
            <ul class="flex items-center gap-4">
                <li><a asp-controller="Home" asp-action="About" class="hover:text-brand-600 transition focus:outline-none focus:ring-2 focus:ring-brand-500 rounded">О себе</a></li>
                <li><a asp-controller="Home" asp-action="Contact" class="hover:text-brand-600 transition focus:outline-none focus:ring-2 focus:ring-brand-500 rounded">Контакты</a></li>
                <li>
                    <a href="/sitemap.xml" class="hover:text-brand-600 transition focus:outline-none focus:ring-2 focus:ring-brand-500 rounded" title="Карта сайта">Sitemap</a>
                </li>
            </ul>
        </div>
    </footer>

    @* ═══ SCRIPTS ════════════════════════════════════════════════ *@
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js" defer></script>
    <script>
        // AOS init — после загрузки AOS-скрипта.
        // defer гарантирует, что скрипт уже загружен к моменту выполнения этого блока.
        window.addEventListener('DOMContentLoaded', function () {
            if (typeof AOS !== 'undefined') {
                AOS.init({
                    duration: 600,
                    easing: 'ease-out-cubic',
                    once: true,
                    offset: 60,
                    disable: 'phone',
                });
            }
        });

        // Burger-меню
        (function () {
            var toggle = document.getElementById('navToggle');
            var menu = document.getElementById('navMenu');
            if (!toggle || !menu) return;

            toggle.addEventListener('click', function () {
                var isHidden = menu.classList.toggle('hidden');
                toggle.setAttribute('aria-expanded', String(!isHidden));
            });
        })();
    </script>

    @* Свой скрипт сайта *@
    <script src="~/js/site.js" asp-append-version="true" defer></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>