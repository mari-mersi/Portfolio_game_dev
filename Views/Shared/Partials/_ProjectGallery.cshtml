@using Portfolio_game_dev.Models
@model List<ProjectMedia>

@*
    Галерея медиа проекта. Показывает картинки и видео.
    Ожидает список ProjectMedia.
*@

@if (Model is not null && Model.Any()) {
    <section class="mt-10">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Галерея</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var media in Model) {
                if (media.Type == MediaType.Video) {
                    <div class="aspect-video rounded-xl overflow-hidden bg-slate-100 border border-slate-200">
                        <video class="w-full h-full object-cover" autoplay muted loop playsinline>
                            <source src="@media.Url" />
                        </video>
                    </div>
                }
                else {
                    <a href="@media.Url" target="_blank" rel="noopener noreferrer"
                       class="block aspect-video rounded-xl overflow-hidden bg-slate-100 border border-slate-200 hover:border-brand-300 transition">
                        <img src="@media.Url"
                             alt="Скриншот проекта"
                             loading="lazy"
                             class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
                    </a>
                }
            }
        </div>
    </section>
}