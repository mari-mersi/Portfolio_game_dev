@model Portfolio_game_dev.Models.BlogPost

@*
    Карточка статьи для сетки на /Blog и главной.
*@

<article class="group bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col h-full">

    @* Обложка *@
    <a asp-controller="Blog" asp-action="Post" asp-route-slug="@Model.Slug"
       class="block relative overflow-hidden aspect-video bg-slate-100">
        @if (!string.IsNullOrEmpty(Model.CoverImageUrl)) {
            <img src="@Model.CoverImageUrl" alt="@Model.Title" loading="lazy"
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        }
        else {
            <div class="w-full h-full flex items-center justify-center text-slate-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z" />
                </svg>
            </div>
        }
    </a>

    @* Контент *@
    <div class="p-5 flex flex-col flex-1">

        @* Дата + время чтения *@
        <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
            @if (Model.PublishedAt.HasValue) {
                <time datetime="@Model.PublishedAt.Value.ToString("yyyy-MM-dd")">
                    @Model.PublishedAt.Value.ToString("d MMMM yyyy")
                </time>
                <span>·</span>
            }
            <span>@Model.ReadTimeMinutes мин</span>
        </div>

        @* Заголовок *@
        <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-brand-600 transition-colors">
            <a asp-controller="Blog" asp-action="Post" asp-route-slug="@Model.Slug">
                @Model.Title
            </a>
        </h3>

        @* Описание *@
        @if (!string.IsNullOrEmpty(Model.Summary)) {
            <p class="text-sm text-slate-600 leading-relaxed line-clamp-3 mb-4">
                @Model.Summary
            </p>
        }

        @* Теги + ссылка *@
        <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between gap-2">
            <div class="flex flex-wrap gap-1.5">
                @foreach (var tag in Model.Tags.Take(3)) {
                    <span class="text-[11px] text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
                        #@tag.Name
                    </span>
                }
            </div>

            <a asp-controller="Blog" asp-action="Post" asp-route-slug="@Model.Slug"
               class="text-sm font-semibold text-brand-600 hover:text-brand-700 inline-flex items-center gap-1 transition shrink-0">
                Читать
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
            </a>
        </div>
    </div>
</article>