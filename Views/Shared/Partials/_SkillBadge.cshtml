@model Portfolio_game_dev.Models.Skill

@*
    Бейдж навыка: иконка (если есть), название, уровень.
    Используется на главной и /Skills.
*@

<div class="inline-flex items-center gap-2 bg-white border border-slate-200 rounded-full px-3 py-1.5 shadow-sm hover:border-brand-300 hover:shadow transition group">

    @if (!string.IsNullOrEmpty(Model.IconUrl)) {
        <img src="@Model.IconUrl" alt="" loading="lazy" class="w-4 h-4 object-contain" />
    }

    <span class="text-sm font-medium text-slate-700 group-hover:text-brand-700 transition">
        @Model.Name
    </span>

    <span class="flex items-center gap-0.5" title="Уровень: @Model.Level / 5">
        @for (int i = 1; i <= 5; i++) {
            <svg xmlns="http://www.w3.org/2000/svg"
                 class="w-3 h-3 @(i <= Model.Level ? "text-amber-400" : "text-slate-200")"
                 viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
        }
    </span>
</div>