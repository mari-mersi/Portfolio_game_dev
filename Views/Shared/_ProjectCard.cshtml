@model Portfolio_game_dev.Models.Project

<div class="bg-gray-800 rounded-xl overflow-hidden border border-gray-700 hover:border-indigo-500 transition-all duration-300 flex flex-col h-full shadow-lg group">
    <div class="relative overflow-hidden">
        <img src="@Model.CoverImageUrl" alt="@Model.Title" class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-500" />
        @if (!string.IsNullOrEmpty(Model.Genre)) {
            <span class="absolute top-3 right-3 bg-black/70 backdrop-blur-md text-xs text-indigo-300 font-medium px-2.5 py-1 rounded-full border border-indigo-500/30">
                @Model.Genre
            </span>
        }
    </div>

    <div class="p-5 flex flex-col flex-grow">
        <!-- Теги -->
        <div class="flex flex-wrap gap-1.5 mb-3">
            @foreach (var tag in Model.Tags) {
                <a asp-controller="Projects" asp-action="Index" asp-route-tag="@tag"
                   class="text-[11px] bg-indigo-950/80 text-indigo-300 px-2 py-0.5 rounded border border-indigo-800/40 hover:bg-indigo-900 transition">
                    #@tag
                </a>
            }
        </div>

        <h3 class="text-xl font-bold text-white mb-1 group-hover:text-indigo-400 transition-colors">@Model.Title</h3>

        @if (!string.IsNullOrEmpty(Model.Role)) {
            <p class="text-xs font-medium text-gray-400 mb-3">Роль: <span class="text-gray-300">@Model.Role</span></p>
        }

        <p class="text-gray-400 text-sm mb-4 flex-grow line-clamp-3">@Model.ShortDescription</p>

        <!-- Стек технологий из свойства TechList в Project.cs -->
        @if (Model.TechList.Any()) {
            <div class="flex flex-wrap gap-1 mb-4">
                @foreach (var tech in Model.TechList) {
                    <span class="text-[11px] bg-gray-700/60 text-gray-300 px-2 py-0.5 rounded">
                        @tech
                    </span>
                }
            </div>
        }

        <div class="pt-4 border-t border-gray-700/60 flex justify-between items-center mt-auto">
            <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Id"
               class="text-indigo-400 hover:text-indigo-300 font-semibold text-sm flex items-center gap-1">
                Подробнее &rarr;
            </a>
            <span class="text-xs text-gray-500">@Model.ReleaseDate.ToString("yyyy")</span>
        </div>
    </div>
</div>