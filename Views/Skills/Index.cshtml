@model Portfolio_game_dev.ViewModels.SkillsIndexViewModel
@{
    ViewData["Title"] ??= "Навыки и стек";
}

<section class="max-w-6xl mx-auto px-4 py-12">
    <header class="mb-10">
        <h1 class="text-4xl font-bold tracking-tight">Навыки и стек</h1>
        <p class="text-gray-500 mt-2">
            Всего навыков: <span class="font-semibold">@Model.TotalSkills</span>
        </p>
    </header>

    @if (Model.FeaturedSkills.Any()) {
        <section class="mb-12">
            <h2 class="text-xl font-semibold mb-4 text-gray-700">Ключевые</h2>
            <div class="flex flex-wrap gap-3">
                @foreach (var skill in Model.FeaturedSkills) {
                    <partial name="_SkillBadge" model="skill" />
                }
            </div>
        </section>
    }

    @foreach (var group in Model.Categories) {
        <section class="mb-10">
            <div class="flex items-baseline justify-between mb-4">
                <h2 class="text-2xl font-semibold">@group.Category</h2>
                <span class="text-sm text-gray-400">
                    средний уровень: @group.AverageLevel.ToString("0.0") / 5
                </span>
            </div>

            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var skill in group.Skills) {
                    <div class="border rounded-xl p-4 bg-white shadow-sm hover:shadow-md transition">
                        <div class="flex items-center gap-3 mb-3">
                            @if (!string.IsNullOrEmpty(skill.IconUrl)) {
                                <img src="@skill.IconUrl" alt="@skill.Name"
                                     class="w-8 h-8" loading="lazy" />
                            }
                            <div class="font-semibold">@skill.Name</div>
                        </div>

                        <div class="flex items-center gap-1" aria-label="Уровень @skill.Level из 5">
                            @for (int i = 1; i <= 5; i++) {
                                <span class="text-lg @(i <= skill.Level ? "text-amber-500" : "text-gray-200")">★</span>
                            }
                        </div>

                        @if (skill.YearsOfExperience > 0) {
                            <div class="text-xs text-gray-400 mt-2">
                                ~@skill.YearsOfExperience @(skill.YearsOfExperience == 1 ? "год" : "года")
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }
</section>