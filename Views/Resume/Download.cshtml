@{
    ViewData["Title"] = "Резюме разработчика";
}

<div class="container mx-auto px-4 py-10 max-w-4xl">
    <!-- Шапка страницы -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4 bg-gray-800 p-6 rounded-2xl border border-gray-700 shadow-xl">
        <div>
            <h1 class="text-3xl font-extrabold text-white">Резюме / CV</h1>
            <p class="text-gray-400 text-sm mt-1">Игровой разработчик / Game Designer</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-controller="Resume" asp-action="Download"
               class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-2.5 px-5 rounded-xl transition shadow-lg shadow-indigo-600/30">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Скачать PDF
            </a>
        </div>
    </div>

    <!-- Интерактивная карточка резюме -->
    <div class="bg-gray-900 border border-gray-800 rounded-2xl p-8 shadow-2xl space-y-8 text-gray-300">
        <!-- Персональные данные -->
        <div class="border-b border-gray-800 pb-6">
            <h2 class="text-3xl font-extrabold text-white mb-1">Иван Иванов</h2>
            <p class="text-indigo-400 font-semibold mb-4">Middle Unity / Unreal Engine Developer</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs text-gray-400">
                <div><span class="font-bold text-gray-200">Email:</span> developer@example.com</div>
                <div><span class="font-bold text-gray-200">Локация:</span> Москва (Remote)</div>
                <div><span class="font-bold text-gray-200">Telegram:</span> @@example</div>
            </div>
        </div>

        <!-- Краткое описание -->
        <div>
            <h3 class="text-xl font-bold text-white mb-2">О себе</h3>
            <p class="leading-relaxed text-sm text-gray-300">
                Разработчик игр с коммерческим опытом создания архитектуры игровых систем, оптимизации графического пайплайна и геймдизайна. Имею опыт выпуска проектов на ПК и мобильные платформы.
            </p>
        </div>

        <!-- Ключевые компетенции -->
        <div>
            <h3 class="text-xl font-bold text-white mb-3">Технологический стек</h3>
            <div class="flex flex-wrap gap-2">
                <span class="bg-indigo-950/80 text-indigo-300 px-3 py-1 rounded-md border border-indigo-800/40 text-xs font-medium">C# / C++</span>
                <span class="bg-indigo-950/80 text-indigo-300 px-3 py-1 rounded-md border border-indigo-800/40 text-xs font-medium">Unity / Unreal Engine 5</span>
                <span class="bg-indigo-950/80 text-indigo-300 px-3 py-1 rounded-md border border-indigo-800/40 text-xs font-medium">Shader Graph / HLSL</span>
                <span class="bg-indigo-950/80 text-indigo-300 px-3 py-1 rounded-md border border-indigo-800/40 text-xs font-medium">Git / Git LFS</span>
                <span class="bg-indigo-950/80 text-indigo-300 px-3 py-1 rounded-md border border-indigo-800/40 text-xs font-medium">Game Architecture</span>
            </div>
        </div>

        <!-- Встроенный просмотрщик PDF (Опционально) -->
        <div class="pt-6 border-t border-gray-800">
            <h3 class="text-xl font-bold text-white mb-4">Предпросмотр документа</h3>
            <div class="w-full h-[600px] bg-gray-800 rounded-xl overflow-hidden border border-gray-700">
                <iframe src="@Url.Action("Download", "Resume")" class="w-full h-full" title="Предпросмотр резюме"></iframe>
            </div>
        </div>
    </div>
</div>