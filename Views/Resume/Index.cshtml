@model Portfolio_game_dev.Models.ResumeViewModel

@{
    ViewData["Title"] = "Резюме / CV";
}

<div class="container mx-auto px-4 py-10 max-w-4xl">
    <!-- Шапка страницы с кнопкой скачивания PDF -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4 bg-gray-800/90 p-6 rounded-2xl border border-gray-700 shadow-xl backdrop-blur-sm">
        <div>
            <h1 class="text-3xl font-extrabold text-white">Резюме / CV</h1>
            <p class="text-gray-400 text-sm mt-1">Интерактивный просмотр и загрузка PDF-версии</p>
        </div>
        <div>
            <a asp-controller="Resume" asp-action="Download"
               class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-2.5 px-5 rounded-xl transition-all duration-200 shadow-lg shadow-indigo-600/30 hover:shadow-indigo-600/50">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Скачать PDF
            </a>
        </div>
    </div>

    <!-- Интерактивная карточка резюме -->
    <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 md:p-10 shadow-2xl space-y-8 text-gray-300">

        <!-- Заголовок и контакты -->
        <div class="border-b border-gray-800 pb-6">
            <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-1">@Model.FullName</h2>
            <p class="text-lg text-indigo-400 font-semibold mb-4">@Model.Title</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs text-gray-400">
                @if (!string.IsNullOrEmpty(Model.Email)) {
                    <div><span class="font-bold text-gray-200">Email:</span> <a href="mailto:@Model.Email" class="hover:text-indigo-400">@Model.Email</a></div>
                }
                @if (!string.IsNullOrEmpty(Model.Phone)) {
                    <div><span class="font-bold text-gray-200">Телефон:</span> @Model.Phone</div>
                }
                @if (!string.IsNullOrEmpty(Model.Location)) {
                    <div><span class="font-bold text-gray-200">Локация:</span> @Model.Location</div>
                }
                @if (!string.IsNullOrEmpty(Model.GitHubUrl)) {
                    <div><span class="font-bold text-gray-200">GitHub:</span> <a href="@Model.GitHubUrl" target="_blank" rel="noopener" class="hover:text-indigo-400">@Model.GitHubUrl</a></div>
                }
                @if (!string.IsNullOrEmpty(Model.TelegramUrl)) {
                    <div><span class="font-bold text-gray-200">Telegram:</span> <a href="@Model.TelegramUrl" target="_blank" rel="noopener" class="hover:text-indigo-400">@Model.TelegramUrl</a></div>
                }
            </div>
        </div>

        <!-- Краткая сводка (О себе) -->
        @if (!string.IsNullOrEmpty(Model.Summary)) {
            <div>
                <h3 class="text-xl font-bold text-white mb-2 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                    О себе
                </h3>
                <p class="leading-relaxed text-sm text-gray-300">
                    @Model.Summary
                </p>
            </div>
        }

        <!-- Опыт работы (Timeline) -->
        @if (Model.Experiences.Any()) {
            <div class="space-y-6">
                <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                    Опыт работы
                </h3>

                <div class="space-y-6 border-l-2 border-gray-800 pl-4 md:pl-6 ml-1">
                    @foreach (var exp in Model.Experiences) {
                        <div class="relative group">
                            <!-- Точка на линии таймлайна -->
                            <div class="absolute -left-[21px] md:-left-[29px] top-1.5 w-3 h-3 rounded-full bg-gray-700 border-2 border-gray-900 group-hover:bg-indigo-500 transition-colors"></div>

                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
                                <h4 class="text-base font-bold text-white">@exp.Position — <span class="text-indigo-400">@exp.Company</span></h4>
                                <span class="text-xs text-gray-400 font-medium">@exp.Period (@exp.DurationText)</span>
                            </div>

                            <p class="text-xs italic text-gray-400 mb-2">@exp.EmploymentType | @exp.Location</p>

                            @if (!string.IsNullOrEmpty(exp.Description)) {
                                <p class="text-sm text-gray-300 mb-2">@exp.Description</p>
                            }

                            @if (exp.Highlights.Any()) {
                                <ul class="list-disc list-inside text-xs text-gray-400 space-y-1 mb-3">
                                    @foreach (var highlight in exp.Highlights) {
                                        <li>@highlight</li>
                                    }
                                </ul>
                            }

                            @if (exp.TechList.Any()) {
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var tech in exp.TechList) {
                                        <span class="text-[11px] bg-gray-800 text-gray-300 px-2 py-0.5 rounded border border-gray-700">@tech</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Навыки и категории -->
        @if (Model.Skills.Any()) {
            <div>
                <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                    Навыки и стек
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var group in Model.Skills.GroupBy(s => s.Category)) {
                        <div class="bg-gray-800/50 p-4 rounded-xl border border-gray-800">
                            <h4 class="text-xs font-semibold text-indigo-400 uppercase tracking-wider mb-2">@group.Key</h4>
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var skill in group) {
                                    <span class="text-xs bg-gray-800 text-gray-200 px-2.5 py-1 rounded-md border border-gray-700">
                                        @skill.Name <span class="text-indigo-400 font-semibold">(@skill.Level/5)</span>
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Предпросмотр встроенного PDF -->
        <div class="pt-6 border-t border-gray-800">
            <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                Предпросмотр оригинального PDF
            </h3>
            <div class="w-full h-[600px] bg-gray-800 rounded-xl overflow-hidden border border-gray-700 shadow-inner">
                <iframe src="@Url.Action("Download", "Resume")" class="w-full h-full" title="PDF Resume"></iframe>
            </div>
        </div>

    </div>
</div>