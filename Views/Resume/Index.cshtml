@model Portfolio_game_dev.ViewModels.ResumeViewModel
@using Portfolio_game_dev.Models

@{
    ViewData["Title"] = "Резюме";
    ViewData["Description"] = "Интерактивное резюме: опыт, навыки, избранные проекты.";
}

<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">

    @* ── Шапка с кнопкой скачивания ───────────────────────── *@
    <header class="mb-10 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 mb-2">Резюме</h1>
            <p class="text-lg text-slate-600">Интерактивный просмотр и PDF-версия для скачивания.</p>
        </div>
        <a asp-controller="Resume" asp-action="Download"
           class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white font-medium px-5 py-2.5 rounded-lg shadow-sm transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1M12 4v12m0 0l-4-4m4 4l4-4" />
            </svg>
            Скачать PDF
        </a>
    </header>

    @* ── Карточка резюме ───────────────────────────────────── *@
    <article class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-10 shadow-sm space-y-8">

        @* Профиль *@
        <header class="border-b border-slate-100 pb-6">
            <h2 class="text-3xl font-extrabold text-slate-900 mb-1">@Model.FullName</h2>
            <p class="text-lg text-brand-600 font-semibold mb-4">@Model.Title</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-slate-600">
                @if (!string.IsNullOrEmpty(Model.Email)) {
                    <div><span class="font-medium text-slate-700">Email:</span> <a href="mailto:@Model.Email" class="hover:text-brand-600">@Model.Email</a></div>
                }
                @if (!string.IsNullOrEmpty(Model.Phone)) {
                    <div><span class="font-medium text-slate-700">Телефон:</span> @Model.Phone</div>
                }
                @if (!string.IsNullOrEmpty(Model.Location)) {
                    <div><span class="font-medium text-slate-700">Локация:</span> @Model.Location</div>
                }
                @if (!string.IsNullOrEmpty(Model.GitHubUrl)) {
                    <div><span class="font-medium text-slate-700">GitHub:</span> <a href="@Model.GitHubUrl" target="_blank" rel="noopener" class="hover:text-brand-600">@Model.GitHubUrl</a></div>
                }
                @if (!string.IsNullOrEmpty(Model.TelegramUrl)) {
                    <div><span class="font-medium text-slate-700">Telegram:</span> <a href="@Model.TelegramUrl" target="_blank" rel="noopener" class="hover:text-brand-600">@Model.TelegramUrl</a></div>
                }
            </div>
        </header>

        @* О себе *@
        @if (!string.IsNullOrEmpty(Model.Summary)) {
            <section>
                <h3 class="text-xl font-bold text-slate-900 mb-3">О себе</h3>
                <p class="text-slate-700 leading-relaxed">@Model.Summary</p>
            </section>
        }

        @* Опыт работы *@
        @if (Model.Experiences.Any()) {
            <section>
                <h3 class="text-xl font-bold text-slate-900 mb-5">Опыт работы</h3>
                <div class="space-y-6">
                    @foreach (var exp in Model.Experiences) {
                        <div class="border-l-2 border-brand-200 pl-4">
                            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1">
                                <h4 class="font-bold text-slate-900">
                                    @exp.Position — <span class="text-brand-600">@exp.Company</span>
                                </h4>
                                <span class="text-xs text-slate-500 whitespace-nowrap">@exp.Period (@exp.DurationText)</span>
                            </div>

                            @{
                                var meta = string.Join(" · ", new[] { exp.EmploymentType, exp.Location }
                                .Where(s => !string.IsNullOrWhiteSpace(s)));
                            }
                            @if (!string.IsNullOrEmpty(meta)) {
                                <p class="text-xs italic text-slate-500 mb-2">@meta</p>
                            }

                            @if (!string.IsNullOrEmpty(exp.Description)) {
                                <p class="text-sm text-slate-700 mb-2">@exp.Description</p>
                            }

                            @if (exp.Highlights.Any()) {
                                <ul class="space-y-1 mb-3">
                                    @foreach (var h in exp.Highlights) {
                                        <li class="text-sm text-slate-700 flex items-start gap-2">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                            </svg>
                                            <span>@h</span>
                                        </li>
                                    }
                                </ul>
                            }

                            @if (exp.TechList.Any()) {
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var tech in exp.TechList) {
                                        <span class="text-xs text-slate-600 bg-slate-100 px-2 py-0.5 rounded">@tech</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        @* Навыки *@
        @if (Model.Skills.Any()) {
            <section>
                <h3 class="text-xl font-bold text-slate-900 mb-5">Навыки и стек</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    @foreach (var group in Model.Skills.GroupBy(s => s.Category)) {
                        <div class="bg-slate-50 border border-slate-100 rounded-xl p-4">
                            <h4 class="text-xs font-semibold text-brand-600 uppercase tracking-wider mb-2">@group.Key</h4>
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var skill in group) {
                                    <span class="text-xs bg-white border border-slate-200 text-slate-700 px-2.5 py-1 rounded-md">
                                        @skill.Name <span class="text-brand-600 font-semibold">(@skill.Level/5)</span>
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        @* Избранные проекты *@
        @if (Model.Projects.Any()) {
            <section>
                <h3 class="text-xl font-bold text-slate-900 mb-5">Избранные проекты</h3>
                <div class="space-y-4">
                    @foreach (var p in Model.Projects) {
                        <div class="border-l-2 border-brand-200 pl-4">
                            <div class="flex items-baseline justify-between gap-2 mb-1">
                                <h4 class="font-bold text-slate-900">
                                    <a asp-controller="Projects" asp-action="DetailsBySlug" asp-route-slug="@p.Slug"
                                       class="hover:text-brand-600 transition">@p.Title</a>
                                </h4>
                                @if (p.ReleaseDate.HasValue) {
                                    <span class="text-xs text-slate-500 whitespace-nowrap">@p.ReleaseDate.Value.Year</span>
                                }
                            </div>

                            @{
                                var meta = string.Join(" · ", new[] { p.Genre, p.Role }
                                .Where(s => !string.IsNullOrWhiteSpace(s)));
                            }
                            @if (!string.IsNullOrEmpty(meta)) {
                                <p class="text-xs italic text-slate-500 mb-1">@meta</p>
                            }

                            @if (!string.IsNullOrEmpty(p.ShortDescription)) {
                                <p class="text-sm text-slate-700">@p.ShortDescription</p>
                            }
                        </div>
                    }
                </div>
            </section>
        }
    </article>
</section>