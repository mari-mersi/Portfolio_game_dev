@model Portfolio_game_dev.ViewModels.ExperienceIndexViewModel

@{
    ViewData["Title"] = "Опыт работы";
    ViewData["Description"] = "Таймлайн студий и проектов, в которых я работал.";
}

<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">

    @* ── Заголовок + статистика ────────────────────────────── *@
    <header class="mb-12 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4"
            data-aos="fade-up">
        <div>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 mb-3">
                Опыт работы
            </h1>
            <p class="text-lg text-slate-600">
                Таймлайн студий и проектов.
            </p>
        </div>

        @if (Model.TotalMonths > 0) {
            <div class="text-sm text-slate-500 sm:text-right">
                <div class="text-2xl font-bold text-slate-900">@Model.TotalExperienceText</div>
                @{
                    string CompanyWord(int n) {
                        var mod10 = n % 10;
                        var mod100 = n % 100;
                        if (mod10 == 1 && mod100 != 11)
                            return "компания";
                        if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14))
                            return "компании";
                        return "компаний";
                    }
                }
                <div>всего: @Model.CompaniesCount @CompanyWord(Model.CompaniesCount)</div>
            </div>
        }
    </header>

    @* ── Пусто ──────────────────────────────────────────────── *@
    @if (!Model.Items.Any()) {
        <div class="text-center py-16 bg-white rounded-2xl border border-dashed border-slate-200">
            <p class="text-slate-500">Пока нет записей об опыте — скоро добавлю.</p>
        </div>
    }
    else {
        @* ── Таймлайн ──────────────────────────────────────── *@
        <div class="relative">
            @* Вертикальная линия *@
            <div class="absolute left-2 top-2 bottom-2 w-px bg-slate-200"></div>

            @foreach (var group in Model.Groups) {
                @* Год *@
                <div class="relative mb-6 pl-10" data-aos="fade-up">
                    <div class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 uppercase tracking-wider bg-slate-50 px-3 py-1 rounded-full border border-slate-200">
                        @group.Year
                    </div>
                </div>

                @* Элементы года *@
                foreach (var exp in group.Items) {
                    <partial name="_TimelineItem" model="exp" />
                }
            }
        </div>

        @* ── Все технологии ────────────────────────────────── *@
        @if (Model.AllTech.Any()) {
            <section class="mt-16 pt-10 border-t border-slate-200" data-aos="fade-up">
                <h2 class="text-2xl font-bold text-slate-900 mb-5">Все инструменты и технологии</h2>
                <div class="flex flex-wrap gap-2">
                    @foreach (var tech in Model.AllTech) {
                        <span class="text-sm text-slate-700 bg-white border border-slate-200 px-3 py-1.5 rounded-full hover:border-brand-300 hover:text-brand-700 transition">
                            @tech
                        </span>
                    }
                </div>
            </section>
        }
    }
</section>