@model ProjectsIndexViewModel

@{
    ViewData["Title"] = "Проекты";
    ViewData["Description"] = "Портфолио игровых проектов: Unity, Unreal Engine, Godot.";
}

<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">

    @* ── Заголовок ──────────────────────────────────────────── *@
    <header class="mb-10">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 mb-3">
            Проекты
        </h1>
        <p class="text-lg text-slate-600">
            Игры, прототипы и технические системы. Всего: <strong>@Model.TotalCount</strong>.
        </p>
    </header>

    @* ── Панель тегов ───────────────────────────────────────── *@
    <partial name="_TagFilter" model="(Model.AllTags, Model.SelectedTag)" />

    @* ── Сетка проектов ─────────────────────────────────────── *@
    @if (!Model.Projects.Any()) {
        <div class="text-center py-20 bg-white rounded-2xl border border-dashed border-slate-200">
            <p class="text-slate-500 text-lg mb-2">По выбранному фильтру ничего не найдено.</p>
            @if (!string.IsNullOrEmpty(Model.SelectedTag)) {
                <a asp-controller="Projects" asp-action="Index"
                   class="text-brand-600 hover:text-brand-700 font-medium text-sm">
                    Сбросить фильтр
                </a>
            }
        </div>
    }
    else {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var project in Model.Projects) {
                <partial name="_ProjectCard" model="project" />
            }
        </div>

        @* ── Пагинация ──────────────────────────────────────── *@
        @if (Model.TotalPages > 1) {
            ViewData["PaginationTag"] = Model.SelectedTag;
            <partial name="_Pagination" model="Model.Paged" />
        }
    }
</section>