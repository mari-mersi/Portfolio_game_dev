@model Portfolio_game_dev.Models.ProjectDetailsViewModel

@{
    ViewData["Title"] = Model.Project.Title;
}

<div class="container mx-auto px-4 py-8 max-w-5xl">
    <a asp-controller="Projects" asp-action="Index" class="inline-flex items-center text-indigo-400 hover:text-indigo-300 mb-6 text-sm font-medium">
        &larr; Назад к списку проектов
    </a>

    <!-- Заголовок -->
    <div class="mb-6">
        <div class="flex flex-wrap gap-2 mb-3">
            @foreach (var tag in Model.Project.Tags) {
                <span class="text-xs bg-indigo-950/80 text-indigo-300 px-2.5 py-1 rounded border border-indigo-800/50">
                    #@tag
                </span>
            }
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-3">@Model.Project.Title</h1>
        <p class="text-xl text-gray-300">@Model.Project.ShortDescription</p>
    </div>

    <!-- Обложка -->
    <div class="mb-8 rounded-2xl overflow-hidden shadow-2xl border border-gray-700">
        <img src="@Model.Project.CoverImageUrl" alt="@Model.Project.Title" class="w-full max-h-[500px] object-cover" />
    </div>

    <!-- Информация и контент -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
        <!-- Левая панель с метаданными и ссылками -->
        <div class="bg-gray-800/90 p-6 rounded-xl border border-gray-700 h-fit space-y-5">
            @if (!string.IsNullOrEmpty(Model.Project.Genre)) {
                <div>
                    <h4 class="text-xs font-semibold uppercase text-gray-400 mb-1">Жанр</h4>
                    <p class="text-white text-sm font-medium">@Model.Project.Genre</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Project.Role)) {
                <div>
                    <h4 class="text-xs font-semibold uppercase text-gray-400 mb-1">Роль в проекте</h4>
                    <p class="text-white text-sm font-medium">@Model.Project.Role</p>
                </div>
            }

            @if (Model.Project.TechList.Any()) {
                <div>
                    <h4 class="text-xs font-semibold uppercase text-gray-400 mb-2">Технологии</h4>
                    <div class="flex flex-wrap gap-1">
                        @foreach (var tech in Model.Project.TechList) {
                            <span class="text-xs bg-gray-700 text-gray-200 px-2.5 py-1 rounded">@tech</span>
                        }
                    </div>
                </div>
            }

            <div>
                <h4 class="text-xs font-semibold uppercase text-gray-400 mb-1">Дата выхода</h4>
                <p class="text-white text-sm font-medium">@Model.Project.ReleaseDate?.ToString("dd MMMM yyyy")</p>
            </div>

            <!-- Внешние ссылки -->
            <div class="pt-4 border-t border-gray-700 flex flex-col gap-2">
                @if (!string.IsNullOrEmpty(Model.Project.SteamUrl)) {
                    <a href="@Model.Project.SteamUrl" target="_blank" rel="noopener noreferrer" class="w-full text-center bg-blue-600 hover:bg-blue-500 text-white font-medium py-2 px-4 rounded-lg text-sm transition">
                        Страница в Steam
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.Project.ItchIoUrl)) {
                    <a href="@Model.Project.ItchIoUrl" target="_blank" rel="noopener noreferrer" class="w-full text-center bg-red-600 hover:bg-red-500 text-white font-medium py-2 px-4 rounded-lg text-sm transition">
                        Посмотреть на Itch.io
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.Project.GooglePlayUrl)) {
                    <a href="@Model.Project.GooglePlayUrl" target="_blank" rel="noopener noreferrer" class="w-full text-center bg-emerald-600 hover:bg-emerald-500 text-white font-medium py-2 px-4 rounded-lg text-sm transition">
                        Google Play
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.Project.GitHubUrl)) {
                    <a href="@Model.Project.GitHubUrl" target="_blank" rel="noopener noreferrer" class="w-full text-center bg-gray-700 hover:bg-gray-600 text-white font-medium py-2 px-4 rounded-lg text-sm transition">
                        Репозиторий на GitHub
                    </a>
                }
            </div>
        </div>

        <!-- Описание Markdown -->
        <div class="lg:col-span-2 text-gray-300 space-y-4 leading-relaxed prose prose-invert max-w-none">
            @Html.Raw(Model.Project.FullDescription.Replace("\n", "<br/>"))
        </div>
    </div>

    <!-- Похожие проекты -->
    @if (Model.RelatedProjects.Any()) {
        <div class="pt-8 border-t border-gray-800">
            <h3 class="text-2xl font-bold text-white mb-6">Другие проекты</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                @foreach (var related in Model.RelatedProjects) {
                    <partial name="_ProjectCard" model="related" />
                }
            </div>
        </div>
    }
</div>