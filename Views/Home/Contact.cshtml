@model Portfolio_game_dev.ViewModels.ContactViewModel
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Контакты";
    ViewData["Description"] = "Свяжитесь со мной: обсудим проект, работу или сотрудничество.";
    var recaptchaEnabled = Configuration.GetValue<bool>("ReCaptcha:Enabled");
    var siteKey = Configuration["ReCaptcha:SiteKey"];
    var isSuccess = TempData["ContactSuccess"] is string;
}

<section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">

    @* ── Заголовок ─────────────────────────────────────────── *@
    <header class="mb-10">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 mb-3">Связаться</h1>
        <p class="text-lg text-slate-600">
            Есть идея, проект или предложение — напишите. Отвечу в течение дня.
        </p>
    </header>

    @* ── Сообщение об успехе ───────────────────────────────── *@
    @if (isSuccess) {
        <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <p class="text-sm text-emerald-800">@TempData["ContactSuccess"]</p>
        </div>
    }

    @* ── Форма ────────────────────────────────────────────── *@
    <form asp-controller="Home" asp-action="Contact" method="post"
          class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm space-y-5"
          id="contact-form">

        @* Валидация общая *@
        <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>

        @* Honeypot — скрыт, боты заполняют *@
        <div style="position:absolute;left:-9999px" aria-hidden="true">
            <label for="Website">Не заполняйте это поле</label>
            <input asp-for="Website" tabindex="-1" autocomplete="off" />
        </div>

        @* Имя *@
        <div>
            <label asp-for="Name" class="block text-sm font-medium text-slate-700 mb-1.5">
                Ваше имя <span class="text-rose-500">*</span>
            </label>
            <input asp-for="Name"
                   class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 focus:bg-white focus:border-brand-400 focus:ring-2 focus:ring-brand-100 outline-none transition"
                   placeholder="Как к вам обращаться" />
            <span asp-validation-for="Name" class="text-xs text-rose-600 mt-1 block"></span>
        </div>

        @* Email *@
        <div>
            <label asp-for="Email" class="block text-sm font-medium text-slate-700 mb-1.5">
                Email <span class="text-rose-500">*</span>
            </label>
            <input asp-for="Email" type="email"
                   class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 focus:bg-white focus:border-brand-400 focus:ring-2 focus:ring-brand-100 outline-none transition"
                   placeholder="you@example.com" />
            <span asp-validation-for="Email" class="text-xs text-rose-600 mt-1 block"></span>
        </div>

        @* Сообщение *@
        <div>
            <label asp-for="Message" class="block text-sm font-medium text-slate-700 mb-1.5">
                Сообщение <span class="text-rose-500">*</span>
            </label>
            <textarea asp-for="Message" rows="6"
                      class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 focus:bg-white focus:border-brand-400 focus:ring-2 focus:ring-brand-100 outline-none transition resize-y"
                      placeholder="Расскажите о задаче или идее..."></textarea>
            <span asp-validation-for="Message" class="text-xs text-rose-600 mt-1 block"></span>
        </div>

        @* reCAPTCHA (hidden token) *@
        <input asp-for="RecaptchaToken" type="hidden" id="recaptcha-token" />

        @* Submit *@
        <div class="pt-2">
            <button type="submit"
                    class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-brand-600 hover:bg-brand-700 text-white font-medium px-6 py-3 rounded-lg shadow-sm transition disabled:opacity-60 disabled:cursor-not-allowed"
                    id="submit-btn">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
                Отправить
            </button>
            <p class="text-xs text-slate-400 mt-3">
                Нажимая «Отправить», вы соглашаетесь на обработку персональных данных.
            </p>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (recaptchaEnabled && !string.IsNullOrEmpty(siteKey)) {
        <script src="https://www.google.com/recaptcha/api.js?render=@siteKey"></script>
        <script>
            (function () {
                const form = document.getElementById('contact-form');
                const tokenInput = document.getElementById('recaptcha-token');
                const submitBtn = document.getElementById('submit-btn');
                const siteKey = '@siteKey';

                form?.addEventListener('submit', function (e) {
                    // Если токен уже получен — пропускаем (повторная валидация)
                    if (tokenInput.value) return;

                    e.preventDefault();
                    submitBtn.disabled = true;

                    grecaptcha.ready(function () {
                        grecaptcha.execute(siteKey, { action: 'contact' })
                            .then(function (token) {
                                tokenInput.value = token;
                                form.submit();
                            })
                            .catch(function () {
                                // Если капча не сработала — всё равно отправляем
                                // (сервер решит, пропускать или нет)
                                form.submit();
                            });
                    });
                });
            })();
        </script>
    }
}