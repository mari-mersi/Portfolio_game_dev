@model Portfolio_game_dev.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Главная";
    ViewData["Description"] = "Портфолио геймдизайнера: проекты на Unity и Godot, навыки, статьи о разработке игр.";
}

@* ═══════════════════════════════════════════════════════════════════
   HERO
   ═══════════════════════════════════════════════════════════════════ *@
<section class="relative overflow-hidden">
    @* Мягкий градиентный фон *@
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-brand-50 via-white to-white"></div>
    <div class="absolute top-0 right-0 -z-10 w-96 h-96 bg-brand-100 rounded-full blur-3xl opacity-50"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28">
        <div class="max-w-3xl" data-aos="fade-up">
            <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-brand-700 bg-brand-50 px-3 py-1 rounded-full border border-brand-100 mb-6">
                <span class="w-1.5 h-1.5 bg-brand-500 rounded-full"></span>
                Открыт к предложениям
            </span>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 mb-6">
                @Model.Hero.Tagline
            </h1>

            <p class="text-lg sm:text-xl text-slate-600 leading-relaxed mb-8">
                @Model.Hero.Subline
            </p>

            <div class="flex flex-wrap gap-3">
                <a href="@Model.Hero.PrimaryCtaUrl"
                   class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white font-medium px-6 py-3 rounded-lg shadow-sm transition">
                    @Model.Hero.PrimaryCtaText
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                </a>
                <a href="@Model.Hero.SecondaryCtaUrl"
                   class="inline-flex items-center gap-2 bg-white hover:bg-slate-50 text-slate-700 font-medium px-6 py-3 rounded-lg border border-slate-200 transition">
                    @Model.Hero.SecondaryCtaText
                </a>
            </div>
        </div>
    </div>
</section>

@* ═══════════════════════════════════════════════════════════════════
   FEATURED PROJECTS
   ═══════════════════════════════════════════════════════════════════ *@
@if (Model.FeaturedProjects.Any()) {
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
        <div class="flex items-end justify-between mb-10" data-aos="fade-up">
            <div>
                <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-2">Избранные проекты</h2>
                <p class="text-slate-600">Работы, которыми я особенно горжусь</p>
            </div>
            <a asp-controller="Projects" asp-action="Index"
               class="hidden sm:inline-flex items-center gap-1 text-sm font-semibold text-brand-600 hover:text-brand-700 transition">
                Все проекты
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var project in Model.FeaturedProjects) {
                <div data-aos="fade-up">
                    <partial name="Partials/_ProjectCard" model="project" />
                </div>
            }
        </div>

        <div class="mt-8 sm:hidden">
            <a asp-controller="Projects" asp-action="Index"
               class="inline-flex items-center gap-1 text-sm font-semibold text-brand-600 hover:text-brand-700 transition">
                Все проекты →
            </a>
        </div>
    </section>
}

@* ═══════════════════════════════════════════════════════════════════
   FEATURED SKILLS
   ═══════════════════════════════════════════════════════════════════ *@
@if (Model.FeaturedSkills.Any()) {
    <section class="bg-white border-y border-slate-200">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
            <div class="mb-10" data-aos="fade-up">
                <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-2">Навыки</h2>
                <p class="text-slate-600">Технологии и инструменты, с которыми работаю каждый день</p>
            </div>

            <div class="flex flex-wrap gap-3" data-aos="fade-up" data-aos-delay="100">
                @foreach (var skill in Model.FeaturedSkills) {
                    <partial name="Partials/_SkillBadge" model="skill" />
                }
            </div>

            <div class="mt-8">
                <a asp-controller="Skills" asp-action="Index"
                   class="inline-flex items-center gap-1 text-sm font-semibold text-brand-600 hover:text-brand-700 transition">
                    Все навыки
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                </a>
            </div>
        </div>
    </section>
}

@* ═══════════════════════════════════════════════════════════════════
   LATEST POSTS
   ═══════════════════════════════════════════════════════════════════ *@
@if (Model.LatestPosts.Any()) {
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
        <div class="flex items-end justify-between mb-10" data-aos="fade-up">
            <div>
                <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-2">Из блога</h2>
                <p class="text-slate-600">Заметки о разработке игр, инструментах и подходе</p>
            </div>
            <a asp-controller="Blog" asp-action="Index"
               class="hidden sm:inline-flex items-center gap-1 text-sm font-semibold text-brand-600 hover:text-brand-700 transition">
                Все статьи
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var post in Model.LatestPosts) {
                <article data-aos="fade-up"
                         class="group bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col">

                    @* Обложка *@
                    <a asp-controller="Blog" asp-action="Post" asp-route-slug="@post.Slug"
                       class="block relative overflow-hidden aspect-video bg-slate-100">
                        @if (!string.IsNullOrEmpty(post.CoverImageUrl)) {
                            <img src="@post.CoverImageUrl" alt="@post.Title" loading="lazy"
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        }
                        else {
                            <div class="w-full h-full flex items-center justify-center text-slate-300">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z" />
                                </svg>
                            </div>
                        }
                    </a>

                    <div class="p-5 flex flex-col flex-1">
                        @* Дата + время чтения *@
                        <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
                            @if (post.PublishedAt.HasValue) {
                                <time datetime="@post.PublishedAt.Value.ToString("yyyy-MM-dd")">
                                    @post.PublishedAt.Value.ToString("d MMMM yyyy")
                                </time>
                                <span>·</span>
                            }
                            <span>@post.ReadTimeMinutes мин</span>
                        </div>

                        @* Заголовок *@
                        <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-brand-600 transition-colors">
                            <a asp-controller="Blog" asp-action="Post" asp-route-slug="@post.Slug">
                                @post.Title
                            </a>
                        </h3>

                        @* Описание *@
                        @if (!string.IsNullOrEmpty(post.Summary)) {
                            <p class="text-sm text-slate-600 leading-relaxed line-clamp-3 mb-4">
                                @post.Summary
                            </p>
                        }

                        @* Теги *@
                        @if (post.Tags.Any()) {
                            <div class="flex flex-wrap gap-1.5 mt-auto pt-4 border-t border-slate-100">
                                @foreach (var tag in post.Tags) {
                                    <span class="text-[11px] text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
                                        #@tag.Name
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    </section>
}

@* ═══════════════════════════════════════════════════════════════════
   ФИНАЛЬНЫЙ CTA (связаться)
   ═══════════════════════════════════════════════════════════════════ *@
<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div data-aos="fade-up"
         class="relative overflow-hidden bg-slate-900 rounded-3xl px-8 sm:px-12 py-12 sm:py-16 text-center">
        <div class="absolute inset-0 bg-gradient-to-br from-brand-600/20 to-transparent"></div>
        <div class="relative">
            <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
                Есть интересный проект?
            </h2>
            <p class="text-slate-300 mb-8 max-w-xl mx-auto">
                Расскажите о задаче — отвечу в течение дня и предложу, чем могу помочь.
            </p>
            <a asp-controller="Home" asp-action="Contact"
               class="inline-flex items-center gap-2 bg-white hover:bg-slate-100 text-slate-900 font-semibold px-6 py-3 rounded-lg transition">
                Написать мне
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
            </a>
        </div>
    </div>
</section>