@model Portfolio_game_dev.ViewModels.BlogIndexViewModel

@{
    ViewData["Title"] = "Блог";
    ViewData["Description"] = "Заметки о геймдизайне, разработке и технических экспериментах.";
}

<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">

    @* Заголовок *@
    <header class="mb-12" data-aos="fade-up">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 mb-3">Блог</h1>
        <p class="text-lg text-slate-600">
            Заметки о геймдизайне, разработке и технических экспериментах.
            Всего статей: <strong>@Model.TotalCount</strong>.
        </p>
    </header>

    @* Список *@
    @if (!Model.Posts.Any()) {
        <div class="text-center py-20 bg-white rounded-2xl border border-dashed border-slate-200">
            <p class="text-slate-500 text-lg">Пока статей нет — скоро появятся.</p>
        </div>
    }
    else {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var post in Model.Posts) {
                <partial name="_BlogCard" model="post" />
            }
        </div>

        @* Пагинация *@
        @if (Model.TotalPages > 1) {
            ViewData["PaginationController"] = "Blog";
            ViewData["PaginationAction"] = "Index";
            <partial name="_Pagination" model="Model.Paged" />
        }
    }
</section>