@model Portfolio_game_dev.ViewModels.BlogPostViewModel

@{
    ViewData["Title"] = Model.Post.Title;
    ViewData["Description"] = Model.Post.Summary ?? Model.Post.Title;
    var post = Model.Post;
}

<article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">

    @* Назад *@
    <a asp-controller="Blog" asp-action="Index"
       class="inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-brand-600 mb-8 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Все статьи
    </a>

    @* Заголовок *@
    <header class="mb-8">
        @if (post.Tags.Any()) {
            <div class="flex flex-wrap gap-2 mb-4">
                @foreach (var tag in post.Tags) {
                    <span class="text-xs font-medium text-brand-700 bg-brand-50 px-2.5 py-1 rounded-full">
                        #@tag.Name
                    </span>
                }
            </div>
        }

        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 mb-4">
            @post.Title
        </h1>

        <div class="flex items-center gap-2 text-sm text-slate-500">
            @if (post.PublishedAt.HasValue) {
                <time datetime="@post.PublishedAt.Value.ToString("yyyy-MM-dd")">
                    @post.PublishedAt.Value.ToString("d MMMM yyyy")
                </time>
                <span>·</span>
            }
            <span>@post.ReadTimeMinutes мин чтения</span>
        </div>
    </header>

    @* Обложка *@
    @if (!string.IsNullOrEmpty(post.CoverImageUrl)) {
        <div class="mb-10 rounded-2xl overflow-hidden border border-slate-200 bg-slate-100">
            <img src="@post.CoverImageUrl" alt="@post.Title" class="w-full max-h-[520px] object-cover" />
        </div>
    }

    @* Markdown-контент *@
    <div class="prose prose-slate max-w-none
                prose-headings:font-bold prose-headings:text-slate-900
                prose-h1:text-3xl prose-h1:mt-10 prose-h1:mb-4
                prose-h2:text-2xl prose-h2:mt-8 prose-h2:mb-3
                prose-h3:text-xl prose-h3:mt-6 prose-h3:mb-2
                prose-p:text-slate-700 prose-p:leading-relaxed
                prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline
                prose-code:text-brand-700 prose-code:bg-brand-50 prose-code:px-1 prose-code:rounded
                prose-pre:bg-slate-900 prose-pre:text-slate-100
                prose-ul:list-disc prose-ul:pl-6
                prose-ol:list-decimal prose-ol:pl-6
                prose-blockquote:border-l-4 prose-blockquote:border-brand-300 prose-blockquote:pl-4 prose-blockquote:italic prose-blockquote:text-slate-600">
        @Html.Raw(Model.RenderedContent)
    </div>

    @* Похожие статьи *@
    @if (Model.RelatedPosts.Any()) {
        <section class="mt-16 pt-10 border-t border-slate-200">
            <h2 class="text-2xl font-bold text-slate-900 mb-6">Читайте также</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var related in Model.RelatedPosts) {
                    <partial name="_BlogCard" model="related" />
                }
            </div>
        </section>
    }
</article>