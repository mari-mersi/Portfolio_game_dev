@model Portfolio_game_dev.Models.Experience
@{
    ViewData["Title"] = "Удаление опыта";
}

<div class="max-w-lg">
    <h1 class="text-2xl font-bold mb-4">Удалить запись?</h1>

    <div class="rounded-xl border bg-white p-5 mb-5">
        <div class="font-semibold text-lg">@Model.Position</div>
        <div class="text-sm text-slate-600">@Model.Company</div>
        <div class="text-xs text-slate-400 mt-1">@Model.Period</div>
    </div>

    <p class="text-sm text-red-600 mb-5">
        Действие необратимо.
    </p>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="flex gap-3">
        <button type="submit"
                class="px-5 py-2 rounded-lg bg-red-600 text-white font-medium hover:bg-red-700">
            Удалить
        </button>
        <a asp-action="Index" class="px-5 py-2 rounded-lg border">Отмена</a>
    </form>
</div>