@model Portfolio_game_dev.Areas.Admin.ViewModels.ExperienceEditViewModel
@{
    ViewData["Title"] = "Новое место работы";
}

<h1 class="text-2xl font-bold mb-6">Новое место работы</h1>

<form asp-action="Create" method="post"
      class="max-w-3xl space-y-5 bg-white p-6 rounded-2xl border">
    <partial name="_ExperienceForm" model="Model" />

    <div class="flex gap-3 pt-4 border-t">
        <button type="submit"
                class="px-5 py-2 rounded-lg bg-brand-600 text-white font-medium hover:bg-brand-700">
            Создать
        </button>
        <a asp-action="Index" class="px-5 py-2 rounded-lg border">Отмена</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}