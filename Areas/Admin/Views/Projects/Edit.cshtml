@model Portfolio_game_dev.Areas.Admin.ViewModels.ProjectEditViewModel
@{
    ViewData["Title"] = $"Редактирование: {Model.Title}";
}

<h1 class="text-2xl font-bold mb-6">Редактирование: @Model.Title</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post"
      enctype="multipart/form-data"
      class="max-w-4xl space-y-5 bg-white p-6 rounded-2xl border">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingCoverImageUrl" />
    <partial name="_ProjectForm" model="Model" />

    <div class="flex gap-3 pt-4 border-t">
        <button type="submit"
                class="px-5 py-2 rounded-lg bg-brand-600 text-white font-medium hover:bg-brand-700">
            Сохранить
        </button>
        <a asp-action="Index" class="px-5 py-2 rounded-lg border">Отмена</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}