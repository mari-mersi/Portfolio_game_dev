@model Portfolio_game_dev.Models.Project
@{
    ViewData["Title"] = "Удаление проекта";
}

<div class="max-w-lg">
    <h1 class="text-2xl font-bold mb-4">Удалить проект?</h1>

    <div class="rounded-xl border bg-white p-5 mb-5 flex gap-4 items-start">
        @if (!string.IsNullOrEmpty(Model.CoverImageUrl)) {
            <img src="@Model.CoverImageUrl" alt="" class="w-20 h-20 rounded-lg object-cover" />
        }
        <div>
            <div class="font-semibold text-lg">@Model.Title</div>
            <div class="text-sm text-slate-500">/@Model.Slug</div>
            @if (!string.IsNullOrEmpty(Model.Genre)) {
                <div class="text-xs text-slate-400 mt-1">@Model.Genre</div>
            }
        </div>
    </div>

    <p class="text-sm text-red-600 mb-5">
        Действие необратимо. Файлы обложки тоже будут удалены.
    </p>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="flex gap-3">
        <button type="submit"
                class="px-5 py-2 rounded-lg bg-red-600 text-white font-medium hover:bg-red-700">
            Удалить
        </button>
        <a asp-action="Index" class="px-5 py-2 rounded-lg border">Отмена</a>
    </form>
</div>