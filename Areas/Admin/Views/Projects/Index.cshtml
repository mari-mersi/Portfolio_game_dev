@model List<Portfolio_game_dev.Models.Project>
@{
    ViewData["Title"] = "Проекты";
    var search = ViewData["SearchTerm"] as string;
}

<div class="max-w-6xl">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Проекты</h1>
            <p class="text-sm text-slate-500 mt-1">Всего: <b>@Model.Count</b></p>
        </div>
        <a asp-action="Create"
           class="px-4 py-2 rounded-lg bg-brand-600 text-white text-sm font-medium hover:bg-brand-700 transition">
            + Добавить проект
        </a>
    </div>

    @if (TempData["Success"] is string ok) {
        <div class="mb-4 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-2 text-sm">
            @ok
        </div>
    }

    <form method="get" class="flex flex-wrap gap-2 mb-4">
        <input type="text" name="search" value="@search"
               placeholder="Поиск по названию или slug..."
               class="border rounded-lg px-3 py-2 text-sm w-64" />
        <button class="px-4 py-2 rounded-lg bg-slate-800 text-white text-sm">Найти</button>
        <a asp-action="Index" class="px-4 py-2 rounded-lg border text-sm">Сброс</a>
    </form>

    @* ── Таблица (md+) ──────────────────────────────────────── *@
    <div class="hidden md:block overflow-x-auto rounded-xl border bg-white">
        <table class="w-full text-sm min-w-[720px]">
            <thead class="bg-slate-50 text-left text-slate-500">
                <tr>
                    <th class="px-4 py-2">Обложка</th>
                    <th class="px-4 py-2">Название</th>
                    <th class="px-4 py-2">Жанр</th>
                    <th class="px-4 py-2">Теги</th>
                    <th class="px-4 py-2">Дата</th>
                    <th class="px-4 py-2">Статус</th>
                    <th class="px-4 py-2 text-right">Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any()) {
                    <tr>
                        <td colspan="7" class="px-4 py-8 text-center text-slate-400">
                            Проекты не найдены
                        </td>
                    </tr>
                }
                @foreach (var p in Model) {
                    <tr class="border-t hover:bg-slate-50">
                        <td class="px-4 py-2">
                            @if (!string.IsNullOrEmpty(p.CoverImageUrl)) {
                                <img src="@p.CoverImageUrl" alt="" class="w-12 h-12 rounded-lg object-cover" />
                            }
                            else {
                                <div class="w-12 h-12 rounded-lg bg-slate-100 flex items-center justify-center text-slate-300 text-xs">
                                    нет
                                </div>
                            }
                        </td>
                        <td class="px-4 py-2">
                            <div class="font-medium text-slate-900">@p.Title</div>
                            <div class="text-xs text-slate-400">/@p.Slug</div>
                        </td>
                        <td class="px-4 py-2 text-slate-600">@p.Genre</td>
                        <td class="px-4 py-2">
                            <div class="flex flex-wrap gap-1">
                                @foreach (var tag in p.Tags.Take(3)) {
                                    <span class="text-[10px] bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded">
                                        @tag.Name
                                    </span>
                                }
                            </div>
                        </td>
                        <td class="px-4 py-2 text-slate-500 text-xs">
                            @p.ReleaseDate?.ToString("dd MMM yyyy")
                        </td>
                        <td class="px-4 py-2">
                            @if (p.IsPublished) {
                                <span class="text-xs bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full">опубликован</span>
                            }
                            else {
                                <span class="text-xs bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full">черновик</span>
                            }
                            @if (p.IsFeatured) {
                                <span class="text-xs bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full ml-1">featured</span>
                            }
                        </td>
                        <td class="px-4 py-2 text-right whitespace-nowrap">
                            <a asp-action="Edit" asp-route-id="@p.Id"
                               class="text-brand-600 hover:underline mr-3">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@p.Id"
                               class="text-red-600 hover:underline">Удалить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── Карточки (мобилка) ────────────────────────────────── *@
    <div class="md:hidden space-y-4">
        @foreach (var p in Model) {
            <div class="bg-white rounded-2xl border border-slate-200 p-4">
                <div class="flex gap-3 mb-3">
                    @if (!string.IsNullOrEmpty(p.CoverImageUrl)) {
                        <img src="@p.CoverImageUrl" alt="" class="w-16 h-16 rounded-lg object-cover flex-shrink-0" />
                    }
                    else {
                        <div class="w-16 h-16 rounded-lg bg-slate-100 flex items-center justify-center text-slate-300 text-xs flex-shrink-0">
                            нет
                        </div>
                    }
                    <div class="min-w-0">
                        <div class="font-bold text-slate-900 truncate">@p.Title</div>
                        <div class="text-xs text-slate-400 truncate">/@p.Slug</div>
                        @if (!string.IsNullOrEmpty(p.Genre)) {
                            <div class="text-xs text-slate-500 mt-1">@p.Genre</div>
                        }
                    </div>
                </div>

                <div class="flex flex-wrap gap-1 mb-3">
                    @if (p.IsPublished) {
                        <span class="text-[10px] bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full">опубликован</span>
                    }
                    else {
                        <span class="text-[10px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full">черновик</span>
                    }
                    @if (p.IsFeatured) {
                        <span class="text-[10px] bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full">featured</span>
                    }
                </div>

                <div class="flex gap-3 pt-3 border-t border-slate-100">
                    <a asp-action="Edit" asp-route-id="@p.Id"
                       class="flex-1 text-center text-sm font-medium text-brand-600 hover:text-brand-700 py-2 rounded-lg hover:bg-brand-50 transition">
                        Изменить
                    </a>
                    <a asp-action="Delete" asp-route-id="@p.Id"
                       class="flex-1 text-center text-sm font-medium text-red-600 hover:text-red-700 py-2 rounded-lg hover:bg-red-50 transition">
                        Удалить
                    </a>
                </div>
            </div>
        }
    </div>
</div>