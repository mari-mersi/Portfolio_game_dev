@model Portfolio_game_dev.Areas.Admin.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Вход в админку";
    Layout = null;   // для логина _AdminLayout не нужен
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Вход в админку</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen flex items-center justify-center bg-slate-100 px-4">

    <div class="w-full max-w-md">

        @* Лого *@
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-brand-600 text-white font-bold text-2xl mb-3">
                GD
            </div>
            <h1 class="text-2xl font-bold text-slate-900">Вход в админку</h1>
            <p class="text-sm text-slate-500 mt-1">Только для администратора</p>
        </div>

        @* Ошибки *@
        @if (!ViewData.ModelState.IsValid) {
            <div class="mb-4 p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 text-sm">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors)) {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        @* Форма *@
        <form asp-area="Admin" asp-controller="Account" asp-action="Login"
              asp-route-returnUrl="@ViewData["ReturnUrl"]"
              method="post"
              class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-4">

            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
                <input asp-for="Email" type="text" autocomplete="username"
                       class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 focus:bg-white focus:border-brand-400 focus:ring-2 focus:ring-brand-100 outline-none transition"
                       placeholder="admin@local" />
                <span asp-validation-for="Email" class="text-xs text-rose-600 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-medium text-slate-700 mb-1.5"></label>
                <input asp-for="Password" type="password" autocomplete="current-password"
                       class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-slate-50 focus:bg-white focus:border-brand-400 focus:ring-2 focus:ring-brand-100 outline-none transition"
                       placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-xs text-rose-600 mt-1 block"></span>
            </div>

            <label class="flex items-center gap-2 text-sm text-slate-700">
                <input asp-for="RememberMe" type="checkbox" class="rounded" />
                <span>Запомнить меня</span>
            </label>

            <button type="submit"
                    class="w-full bg-brand-600 hover:bg-brand-700 text-white font-medium py-2.5 rounded-lg shadow-sm transition">
                Войти
            </button>
        </form>

        <p class="text-center text-xs text-slate-400 mt-6">
            © @DateTime.UtcNow.Year GameDev Portfolio
        </p>
    </div>
</body>
</html>