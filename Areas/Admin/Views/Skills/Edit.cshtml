@using Portfolio_game_dev.Areas.Admin.ViewModels
@model SkillEditViewModel
@{
    ViewData["Title"] = "Редактирование навыка";
}

<h1 class="text-2xl font-bold mb-6">Редактирование: @Model.Name</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="max-w-2xl space-y-5">
    <input type="hidden" asp-for="Id" />
    <partial name="_SkillForm" model="Model" />

    <div class="flex gap-3 pt-2">
        <button type="submit"
                class="px-5 py-2 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-700">
            Сохранить
        </button>
        <a asp-action="Index" class="px-5 py-2 rounded-lg border">Отмена</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}