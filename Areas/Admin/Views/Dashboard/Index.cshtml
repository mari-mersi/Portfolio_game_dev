@{
    ViewData["Title"] = "Дашборд";
}

<div class="max-w-5xl">
    <h1 class="text-2xl font-bold text-slate-900 mb-2">
        Привет, админ!
    </h1>
    <p class="text-slate-500 mb-8">
        Это стартовая страница админки. Скоро здесь появится статистика.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <div class="text-xs uppercase tracking-wider text-slate-400 mb-1">Проекты</div>
            <div class="text-3xl font-bold text-slate-900">—</div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <div class="text-xs uppercase tracking-wider text-slate-400 mb-1">Навыки</div>
            <div class="text-3xl font-bold text-slate-900">—</div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <div class="text-xs uppercase tracking-wider text-slate-400 mb-1">Статьи</div>
            <div class="text-3xl font-bold text-slate-900">—</div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <div class="text-xs uppercase tracking-wider text-slate-400 mb-1">Сообщения</div>
            <div class="text-3xl font-bold text-slate-900">—</div>
        </div>
    </div>

    <p class="text-sm text-slate-400 mt-8">
        Статистика появится в Дне 9 (Admin Dashboard + CRUD).
    </p>
</div>