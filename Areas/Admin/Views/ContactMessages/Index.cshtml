@model List<Portfolio_game_dev.Models.ContactMessage>
@{
    ViewData["Title"] = "Сообщения";
    var status = ViewData["StatusFilter"] as string;
    var unread = Model.Count(m => !m.IsRead);
}

<div class="max-w-6xl">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Сообщения</h1>
            <p class="text-sm text-slate-500 mt-1">
                Всего: <b>@Model.Count</b>
                @if (unread > 0) {
                    <text> · Непрочитанных: <b class="text-brand-600">@unread</b></text>
                }
            </p>
        </div>
    </div>

    @if (TempData["Success"] is string ok) {
        <div class="mb-4 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-2 text-sm">
            @ok
        </div>
    }

    <div class="flex flex-wrap gap-2 mb-4">
        <a asp-action="Index"
           class="px-4 py-2 rounded-lg text-sm font-medium transition @(string.IsNullOrEmpty(status) ? "bg-brand-600 text-white" : "bg-white border text-slate-600 hover:border-brand-300")">
            Все
        </a>
        <a asp-action="Index" asp-route-status="unread"
           class="px-4 py-2 rounded-lg text-sm font-medium transition @(status == "unread" ? "bg-brand-600 text-white" : "bg-white border text-slate-600 hover:border-brand-300")">
            Непрочитанные
        </a>
        <a asp-action="Index" asp-route-status="read"
           class="px-4 py-2 rounded-lg text-sm font-medium transition @(status == "read" ? "bg-brand-600 text-white" : "bg-white border text-slate-600 hover:border-brand-300")">
            Прочитанные
        </a>
    </div>

    @if (!Model.Any()) {
        <div class="text-center py-20 bg-white rounded-2xl border border-dashed border-slate-200">
            <p class="text-slate-500">Сообщений нет.</p>
        </div>
    }
    else {
        <div class="space-y-3">
            @foreach (var m in Model) {
                <div class="bg-white rounded-2xl border @(m.IsRead ? "border-slate-200" : "border-brand-300 bg-brand-50/30") p-4">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2 mb-1">
                                @if (!m.IsRead) {
                                    <span class="w-2 h-2 bg-brand-500 rounded-full flex-shrink-0"></span>
                                }
                                <span class="font-semibold text-slate-900 truncate">@m.Name</span>
                                <span class="text-sm text-slate-500 truncate">@m.Email</span>
                            </div>
                            <p class="text-sm text-slate-600 line-clamp-2 mb-2">@m.Message</p>
                            <div class="text-xs text-slate-400">
                                @m.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                            </div>
                        </div>

                        <div class="flex gap-2 flex-shrink-0">
                            <a asp-action="Details" asp-route-id="@m.Id"
                               class="text-sm text-brand-600 hover:underline">Открыть</a>

                            <form asp-action="ToggleRead" asp-route-id="@m.Id" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-sm text-slate-500 hover:underline">
                                    @(m.IsRead ? "В непрочитанные" : "Прочитано")
                                </button>
                            </form>

                            <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="inline"
                                  onsubmit="return confirm('Удалить сообщение?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-sm text-red-600 hover:underline">Удалить</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>