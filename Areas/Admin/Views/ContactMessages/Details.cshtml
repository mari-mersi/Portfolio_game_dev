@model Portfolio_game_dev.Models.ContactMessage
@{
    ViewData["Title"] = $"Сообщение от {Model.Name}";
}

<div class="max-w-3xl">
    <a asp-action="Index"
       class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-brand-600 mb-6 transition">
        ← Все сообщения
    </a>

    <div class="bg-white rounded-2xl border border-slate-200 p-6">
        <header class="mb-6 pb-4 border-b border-slate-100">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <h1 class="text-xl font-bold text-slate-900">@Model.Name</h1>
                    <div class="text-sm text-slate-500 mt-1">
                        <a href="mailto:@Model.Email" class="text-brand-600 hover:underline">@Model.Email</a>
                    </div>
                </div>
                <div class="text-xs text-slate-400 text-right">
                    @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                </div>
            </div>
        </header>

        <div class="prose prose-slate max-w-none">
            <p class="whitespace-pre-wrap text-slate-700">@Model.Message</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.IpHash)) {
            <div class="mt-6 pt-4 border-t border-slate-100 text-xs text-slate-400">
                IP hash: <code class="font-mono">@Model.IpHash[..16]…</code>
            </div>
        }
    </div>

    <div class="flex gap-3 mt-6">
        <a href="mailto:@Model.Email" class="px-5 py-2 rounded-lg bg-brand-600 text-white font-medium hover:bg-brand-700">
            Ответить на email
        </a>

        <form asp-action="ToggleRead" asp-route-id="@Model.Id" method="post" class="inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.Id })" />
            <button type="submit" class="px-5 py-2 rounded-lg border font-medium hover:bg-slate-50">
                @(Model.IsRead ? "Пометить как непрочитанное" : "Пометить как прочитанное")
            </button>
        </form>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="inline"
              onsubmit="return confirm('Удалить сообщение?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="px-5 py-2 rounded-lg border border-red-300 text-red-600 font-medium hover:bg-red-50">
                Удалить
            </button>
        </form>
    </div>
</div>