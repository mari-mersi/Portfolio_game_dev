<!DOCTYPE html>
<html lang="ru" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Админка</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50:  '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        },
                    },
                },
            },
        };
    </script>
</head>
<body class="h-full bg-slate-100 text-slate-800 font-sans antialiased">

    <div class="flex min-h-screen">

        @* ── Sidebar ─────────────────────────────────────────── *@
        <aside class="w-64 bg-slate-900 text-slate-300 flex flex-col">

            @* Лого *@
            <div class="px-5 py-5 border-b border-slate-800 flex items-center gap-2">
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-brand-600 text-white text-sm font-bold">
                    GD
                </span>
                <span class="text-white font-bold">Админка</span>
            </div>

            @* Навигация *@
            <nav class="flex-1 px-3 py-4 space-y-1 text-sm">

                @{
                    string Current(string controller) =>
                    (ViewContext.RouteData.Values["controller"]?.ToString() == controller)
                    ? "bg-slate-800 text-white"
                    : "hover:bg-slate-800 hover:text-white";
                }

                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                   class="flex items-center gap-3 px-3 py-2 rounded-lg transition @Current("Dashboard")">
                    <span>📊</span> Дашборд
                </a>
                <a asp-area="Admin" asp-controller="Projects" asp-action="Index"
                   class="flex items-center gap-3 px-3 py-2 rounded-lg transition @Current("Projects")">
                    <span>🎮</span> Проекты
                </a>
                <a asp-area="Admin" asp-controller="Skills" asp-action="Index"
                   class="flex items-center gap-3 px-3 py-2 rounded-lg transition @Current("Skills")">
                    <span>⚡</span> Навыки
                </a>
                <a asp-area="Admin" asp-controller="Experience" asp-action="Index"
                   class="flex items-center gap-3 px-3 py-2 rounded-lg transition @Current("Experience")">
                    <span>💼</span> Опыт
                </a>
                <a asp-area="Admin" asp-controller="Blog" asp-action="Index"
                   class="flex items-center gap-3 px-3 py-2 rounded-lg transition @Current("Blog")">
                    <span>📝</span> Блог
                </a>
                <a asp-area="Admin" asp-controller="ContactMessages" asp-action="Index"
                   class="flex items-center gap-3 px-3 py-2 rounded-lg transition @Current("ContactMessages")">
                    <span>✉️</span> Сообщения
                </a>
            </nav>

            @* Пользователь + логаут *@
            <div class="border-t border-slate-800 px-4 py-4 space-y-3">
                <div class="text-xs text-slate-500">
                    Вы вошли как<br />
                    <span class="text-slate-300 font-medium">@User.Identity?.Name</span>
                </div>
                <form asp-area="Admin" asp-controller="Account" asp-action="Logout"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="w-full text-sm bg-slate-800 hover:bg-slate-700 text-slate-200 py-2 px-3 rounded-lg transition">
                        Выйти
                    </button>
                </form>
                <a asp-area="" asp-controller="Home" asp-action="Index"
                   class="block text-xs text-slate-500 hover:text-slate-300 transition">
                    ← На сайт
                </a>
            </div>
        </aside>

        @* ── Контент ─────────────────────────────────────────── *@
        <main class="flex-1 p-8 overflow-x-auto">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>